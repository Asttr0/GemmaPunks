{
  "name": "gemmapunks",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "lint": "npm --workspace apps/web run lint",
    "test": "npm --workspace apps/web run test",
    "format": "npm --workspace apps/web run format",
    "firebase:emulators": "firebase emulators:start --project demo-gemmapunks --only auth,firestore",
    "firebase:test-rules": "firebase emulators:exec --project demo-gemmapunks --only firestore \"node --test tests/firebase/firestore.rules.test.mjs\"",
    "firebase:validate-seed": "node scripts/seed_firebase.mjs --validate-only",
    "firebase:seed-emulator": "firebase emulators:exec --project demo-gemmapunks --only auth,firestore \"node scripts/seed_firebase.mjs --project demo-gemmapunks --verify\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0"
  }
}
